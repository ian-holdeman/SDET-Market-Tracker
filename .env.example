# Server PORT is a process environment variable; defaults to 3000.
# Gemini is not used. Playwright runs an isolated local server on port 3100.

# Supabase client (public, embedded during build). Generate local values with:
# npm run auth:setup:local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Server-only account deletion and searched-asset registration. NEVER add VITE_ to the secret variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local Google provider credentials belong in ignored root .env for the CLI.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Read-only public test history from GitHub Actions (all server-only).
# Fine-grained token: this repository only, Actions: read. Never use VITE_.
TEST_HISTORY_REPOSITORY=
TEST_HISTORY_BRANCH=
TEST_HISTORY_TOKEN=

# Server-only local snapshot directory. Cloud Run uses private Cloud Storage instead.
# Defaults to .telemetry/snapshots relative to the server working directory.
# TEST_SNAPSHOT_DIRECTORY=/private/persistent/test-snapshots

# Cloud Run runtime only; distinct private buckets and attached identity (ADC).
# APP_DEPLOYMENT=cloud-run
# APP_ORIGIN=https://<provider-issued-service-origin>
# TEST_SNAPSHOT_BUCKET=<private-snapshot-bucket>
# TEST_ARCHIVE_BUCKET=<private-archive-bucket>
# RELEASE_COMMIT is an immutable 40-character commit passed to the production build.

# Owner-only opt-in independent comparison. Never embed in VITE_ variables or CI evidence.
# FINNHUB_API_KEY=
