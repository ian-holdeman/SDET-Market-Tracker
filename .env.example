# Optional legacy Firebase configuration for test history only.
# Copy to .env.local and use your Firebase web application's configuration.
# VITE_* values are public and embedded at build time. Never put private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Use the actual provisioned database ID, or leave empty for (default).
VITE_FIREBASE_DATABASE_ID=

# Server PORT is a process environment variable; defaults to 3000.
# Gemini is not used. Playwright runs an isolated local server on port 3100.

# Supabase client (public, embedded during build). Generate local values with:
# npm run auth:setup:local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Server-only account deletion and searched-asset registration. NEVER add VITE_ to the secret variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local Google provider credentials belong in ignored root .env for the CLI.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
