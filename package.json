{
  "name": "sdet-market-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset --local",
    "db:test": "node scripts/supabase.mjs test db --local",
    "db:lint": "node scripts/supabase.mjs db lint --local --schema public,private --level warning --fail-on warning",
    "dev": "tsx server.ts --development",
    "build": "npm run clean && vite build --outDir dist/client && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/server.mjs",
    "start": "node dist/server/server.mjs",
    "preview": "npm start",
    "clean": "node scripts/clean.mjs",
    "test:baseline": "tsx --test scripts/tests/*.test.ts",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ingest": "tsx scripts/ingest-test-results.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "auth:setup:local": "node scripts/setup-local-auth.mjs",
    "test:auth": "tsx --test scripts/auth-tests/*.test.ts",
    "build:e2e": "node scripts/build-browser-tests.mjs",
    "test:market:live": "tsx scripts/check-market-provider.ts",
    "test:market:coverage": "tsx scripts/check-market-coverage.ts",
    "test:pipeline:live": "tsx scripts/check-pipeline.ts",
    "record:showcase": "node scripts/capture-showcase.mjs",
    "record:showcase:prepare": "tsx scripts/prepare-showcase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
