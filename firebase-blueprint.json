{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with username, hashed passcode, and saved watchlist",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Unique username alias"
        },
        "passcodeHash": {
          "type": "string",
          "description": "SHA-256 hashed passcode"
        },
        "watchlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of stock ticker symbols saved by user"
        }
      },
      "required": ["username", "passcodeHash", "watchlist"]
    },
    "TestRun": {
      "title": "TestRun",
      "description": "Automated Playwright CI/CD test execution telemetry record",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "description": "Unique run identifier"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the run"
        },
        "branch": {
          "type": "string",
          "description": "Git branch name"
        },
        "commitSha": {
          "type": "string",
          "description": "Git commit SHA"
        },
        "commitMessage": {
          "type": "string",
          "description": "Git commit subject line"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "flaky", "timedOut"],
          "description": "Overall status of the test run"
        },
        "totalTests": {
          "type": "number",
          "description": "Total number of tests executed"
        },
        "passed": {
          "type": "number",
          "description": "Number of passed tests"
        },
        "failed": {
          "type": "number",
          "description": "Number of failed tests"
        },
        "skipped": {
          "type": "number",
          "description": "Number of skipped tests"
        },
        "durationMs": {
          "type": "number",
          "description": "Total execution duration in milliseconds"
        },
        "passRate": {
          "type": "number",
          "description": "Calculated pass rate percentage"
        },
        "environment": {
          "type": "string",
          "description": "Execution environment (e.g. github-actions, local)"
        },
        "suites": {
          "type": "array",
          "description": "Breakdown of individual test suites and specs"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        }
      },
      "required": ["runId", "status", "totalTests", "passed", "failed", "durationMs", "createdAt"]
    }
  },
  "firestore": {
    "/users/{username}": {
      "schema": "User",
      "description": "User account and watchlist documents"
    },
    "/test_runs/{runId}": {
      "schema": "TestRun",
      "description": "CI/CD and local test run telemetry records"
    }
  }
}
